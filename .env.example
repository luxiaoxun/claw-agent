# =============================================================================
# SomaAgent - 环境变量配置示例
# =============================================================================
# 复制此文件为 .env 并根据实际情况修改配置值
# cp .env.example .env
# =============================================================================

# LLM配置
OPENAI_API_KEY=your-api-key
LLM_MODEL=your-model-name
OPENAI_BASE_URL=http://your-gateway.example.com

# 本地Elasticsearch配置
# ES_HOSTS=http://localhost:9200

# MCP配置
# MCP_SERVER_URL=http://127.0.0.1:8000/sse

# =============================================================================
# 鉴权配置
# =============================================================================
# AUTH_MODE: shared | standalone
#   shared - 共享模式，从请求头 X-User-Id 获取用户ID（集成部署时使用）
#   standalone - 独立模式，使用 API Key 认证，绑定默认用户 admin
AUTH_MODE=shared

# API_KEY: Standalone 模式下的 API Key
# API_KEY=your-secret-api-key

# TRUSTED_ORIGINS: Shared 模式信任的来源域名，逗号分隔，* 表示全部
# TRUSTED_ORIGINS=*

# VERIFY_SHARED_TOKEN: 是否验证 Shared Token
# VERIFY_SHARED_TOKEN=false